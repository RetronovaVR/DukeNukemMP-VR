# --- Synchronization and Latency ---
# Disable VSync so the game window does not throttle the VR render thread
d3d8.presentInterval = 0
d3d9.presentInterval = 0
dxgi.syncInterval = 0

# Minimal latency for VR (prevents GPU queue lag during head motion)
d3d8.maxFrameLatency = 1
d3d9.maxFrameLatency = 1

# --- FPS Limiting and GPU/CPU Optimization ---
# DXVK global frame limiter matching VR headset refresh rate (90 Hz)
dxvk.frameRate = 90

# Optional diagnostic OSD (FPS, frametimes, draw calls)
# dxvk.hud = fps,frametimes,submissions,drawcalls